# Pinned verification toolchain for eterea.
#
# This file is data only: source it, do not execute it. Every script under
# scripts/verify/ sources it so the pins live in exactly one place.
#
# All tools install under $ETEREA_ROOT/.tools (inside the workspace). Nothing
# is installed system-wide, no sudo is used, and no HOME-level rustup/cargo
# state is required or written by the scripts.
#
# Bumping a pin: change the version here, delete the matching directory under
# .tools/ and rerun scripts/verify/install.sh <tool>.

# --- Verus ------------------------------------------------------------------
# Release tag:     release/0.2026.11.02.8bf68ee
# Upstream notes:  https://github.com/verus-lang/verus/releases/tag/release/0.2026.11.02.8bf68ee
# Asset:          verus-0.2026.11.02.8bf68ee-x86-linux.zip (x86 = x86_64 Linux)
VERUS_VERSION="0.2026.11.02.8bf68ee"
VERUS_ASSET="verus-${VERUS_VERSION}-x86-linux.zip"
VERUS_URL="https://github.com/verus-lang/verus/releases/download/release/${VERUS_VERSION}/${VERUS_ASSET}"
# sha256 of VERUS_ASSET, taken from the GitHub release asset digest.
VERUS_SHA256="f3a0119292df8855e4435da8130bee1873b0e6a60c306accf81a08ea687bba3c"
VERUS_TOPLEVEL="verus-${VERUS_VERSION}-x86-linux"
# The 2026 Verus releases are rustup-managed: the `verus` wrapper shells out to
# `rustup` and needs this exact toolchain installed (read from the release's
# version.json). install.sh installs it into .tools/rustup.
VERUS_TOOLCHAIN="1.99.1"

# --- Kani -------------------------------------------------------------------
# Release tag:     kani-0.68.0
# Upstream notes:  https://github.com/model-checking/kani/releases/tag/kani-0.68.0
# Kani ships a self-contained toolchain; it does not use rustup.
KANI_VERSION="0.68.0"
KANI_ASSET="kani-${KANI_VERSION}-x86_64-unknown-linux-gnu.tar.gz"
KANI_URL="https://github.com/model-checking/kani/releases/download/kani-${KANI_VERSION}/${KANI_ASSET}"
# sha256 of KANI_ASSET, taken from the GitHub release asset digest.
KANI_SHA256="32e2b484d73ede0bbf64a2cf0879c4259422497d8aec4ee67d448de9ae7843d3"
KANI_TOPLEVEL="kani-${KANI_VERSION}"
# Kani's release bundle deliberately omits the Rust toolchain; the normal
# `cargo install kani-verifier` + `cargo kani setup` flow installs it into
# <bundle>/toolchain. We do the same non-interactively: install this toolchain
# with rustup under .tools/rustup and symlink <bundle>/toolchain to it.
# The pin must match the bundle's rust-toolchain-version file
# (`nightly-2026-08-21-x86_64-unknown-linux-gnu`); install.sh fails if not.
KANI_TOOLCHAIN_NIGHTLY="nightly-2026-08-21"
KANI_TOOLCHAIN="${KANI_TOOLCHAIN_NIGHTLY}-x86_64-unknown-linux-gnu"

# --- Miri -------------------------------------------------------------------
# Miri is shipped as a rustup component of a specific nightly. The nightly
# date is the pin; the rustc version below is the nightly manifest's
# [pkg.rustc] version at that date, recorded only for readability.
MIRI_NIGHTLY="nightly-2026-11-16"
MIRI_RUSTC_VERSION="1.102.0-nightly (5f4effd57 2026-11-13)"
MIRI_COMPONENT="miri"

# --- rustup (bootstrap for Miri only) --------------------------------------
# Exact archive URL for rustup 1.29.3 (release-stable.toml said 1.29.3 when
# this was pinned). rustup itself is installed under .tools/rustup, not $HOME.
RUSTUP_VERSION="1.29.3"
RUSTUP_INIT_URL="https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/x86_64-unknown-linux-gnu/rustup-init"
RUSTUP_INIT_SHA256="b1c8cb14e30889e7e2999e6b69e62d9e9b9ffc0f4df8180564d306d9680e6c55"

# --- cargo-fuzz -------------------------------------------------------------
# Only needed once fuzz targets exist. Installed with `cargo install` into
# .tools/cargo-fuzz, using a CARGO_HOME inside the workspace.
CARGO_FUZZ_VERSION="0.13.2"

# --- Download policy --------------------------------------------------------
# Seconds allowed per download / per build step. The install script is meant
# to be interruption-tolerant: a partial download is deleted, not reused.
DOWNLOAD_TIMEOUT="${DOWNLOAD_TIMEOUT:-300}"
CONNECT_TIMEOUT="${CONNECT_TIMEOUT:-15}"
# Seconds allowed for a build/install step (cargo-fuzz, rustup toolchain).
BUILD_TIMEOUT="${BUILD_TIMEOUT:-300}"
